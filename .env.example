# ── Telegram (required) ──
TELEGRAM_BOT_TOKEN=
MY_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# ── Database ──
DATABASE_URL=

# ── Data APIs ──
COINGECKO_API_KEY=
CMC_API_KEY=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
CHARTIMG_API_KEY=
# MORALIS_API_KEY is no longer used (ETH/Base holders come from free Blockscout)
# Free key at goldrush.dev — REQUIRED for /w holder charts on BSC and Avalanche tokens (add it in Render)
GOLDRUSH_API_KEY=

# ── Discord (optional — leave blank to run Telegram only) ──
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Your own Discord user id (admin commands). Optional.
DISCORD_ADMIN_ID=
# Optional: register slash commands instantly in one test server
DISCORD_GUILD_ID=
# Optional: Discord Premium App SKU ids (Developer Portal > Monetization)
DISCORD_SKU_REGULAR=
DISCORD_SKU_PRO=
